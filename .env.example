# ABA PayWay sandbox credentials
# Copy this file to ".env" and fill in the values from the credential
# sheet ABA sent you. ".env" is gitignored — never commit real credentials.
#
# Get sandbox credentials at: https://sandbox.payway.com.kh/register-sandbox/

# --- Required: the SDK uses these three -------------------------------------

# "Merchant Id" on the credential sheet.
ABA_MERCHANT_ID=your_sandbox_merchant_id

# "Public Key" on the credential sheet. Despite the name this is a SECRET —
# it is the HMAC-SHA512 key used to sign every request. Not the RSA key below.
ABA_API_KEY=your_sandbox_public_key

# "API Url" on the credential sheet. You may paste either the origin or the
# full purchase URL; the SDK keeps only the origin either way.
#   sandbox:    https://checkout-sandbox.payway.com.kh
#   production: https://checkout.payway.com.kh
ABA_BASE_URL=https://checkout-sandbox.payway.com.kh

# --- Optional ---------------------------------------------------------------

# Used by verifyWebhook() to check webhook signatures.
ABA_WEBHOOK_SECRET=your_sandbox_webhook_secret

# --- RSA key pair: NOT used by this SDK -------------------------------------
#
# ABA ships an "RSA Public Key" and "RSA Private Key" with every credential
# sheet, but none of the endpoints this SDK calls (purchase,
# check-transaction-2, webhook verification) use them — those are all
# HMAC-SHA512 signed with ABA_API_KEY above.
#
# The RSA pair is for the payout/refund family of APIs, which ABA enables per
# merchant on request. On a default sandbox merchant `/payments/refund`
# returns HTTP 404, i.e. it is not switched on.
#
# Leave these unset unless you have asked ABA to enable those APIs. They are
# listed here only so the credential sheet maps cleanly onto this file.
#
# PEM blocks are multi-line, so they must be double-quoted to survive dotenv:
#   ABA_RSA_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----
#   MIGfMA0GCSq...
#   -----END PUBLIC KEY-----"
#
# ABA_RSA_PUBLIC_KEY=
# ABA_RSA_PRIVATE_KEY=
